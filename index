 for(let dy=-ry;dy<=ry;dy++){const tt=dy/ry,w=R(rx*Math.sqrt(Math.max(0,1-tt*tt)));
  if(!chk)ctx.fillRect(cx-w,cy+dy,w*2+1,1);
