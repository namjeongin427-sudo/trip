#dimpanel .dm-card{display:flex;flex-direction:column;gap:6px;padding:10px;background:#1f4a52;border:4px solid #46f0c8;box-shadow:0 0 0 3px #ffd24a,inset -3px -3px 0 rgba(0,0,0,.35),inset 3px 3px 0 rgba(255,255,255,.15)}
#dimpanel .dm-card b{font-size:14px;text-shadow:1px 1px 0 #000}
#dimpanel .dm-card i{font-style:normal;font-size:12px;color:#c9e8ee;line-height:1.5}
#dimpanel .dm-row{display:flex;gap:8px}
#dimpanel button{font:inherit;font-weight:900;font-size:13px;color:#fff;background:var(--btn);border:4px solid #0b0b10;padding:8px 14px;box-shadow:inset -3px -3px 0 rgba(0,0,0,.35),inset 3px 3px 0 rgba(255,255,255,.25),3px 3px 0 #000;text-shadow:1px 1px 0 #000}
#dimpanel button:active{transform:translate(2px,2px)}
#dimpanel #dim-go{background:#2bc9a6;color:#04302a;text-shadow:1px 1px 0 rgba(255,255,255,.4)}
#st{position:absolute;top:calc(8px + env(safe-area-inset-top,0px));left:calc(10px + env(safe-area-inset-left,0px));font-size:13px;font-weight:900;color:#fff;text-shadow:2px 2px 0 #000;pointer-events:none}
#rot{display:none;position:absolute;top:calc(48px + env(safe-area-inset-top,0px));left:0;right:0;text-align:center;font-size:13px;pointer-events:none;opacity:.9;text-shadow:2px 2px 0 #000}
@media (orientation:portrait){#rot{display:block}}

#syspanel{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:rgba(5,6,16,.74);z-index:30}
#syspanel .sp-box{width:min(96vw,740px);max-height:96vh;overflow:auto;background:#10132a;border:4px solid #0b0b10;box-shadow:6px 6px 0 #000,inset 0 0 0 3px #2b3366;padding:10px 12px;display:flex;flex-direction:column;gap:8px;font-family:ui-monospace,Menlo,Consolas,'Apple SD Gothic Neo','Noto Sans KR',monospace;color:#eaf0ff}
#syspanel .sp-top{display:flex;justify-content:space-between;align-items:center;font-weight:900;font-size:14px;color:#ff9ce0;text-shadow:2px 2px 0 #000;letter-spacing:1px}
#syspanel .sp-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:8px}
#syspanel .mon{position:relative;background:#0c2a2e;border:4px solid #0b0b10;box-shadow:inset 0 0 0 2px #4b5070,3px 3px 0 #000;padding:6px 8px;display:flex;flex-direction:column;gap:5px;font-size:11px;line-height:1.5;transform-origin:center}
#syspanel .mon::after{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.22) 0 1px,transparent 1px 3px)}
#syspanel .mon h4{margin:0;font-size:11px;color:#8dfbe0;letter-spacing:1px;border-bottom:2px solid #1d5a60;padding-bottom:3px}
#syspanel .m-keys{grid-row:1/4}
#syspanel button{position:relative;z-index:1;font:inherit;font-weight:900;font-size:12px;color:#fff;background:var(--btn);border:3px solid #0b0b10;padding:5px 9px;box-shadow:inset -2px -2px 0 rgba(0,0,0,.35),inset 2px 2px 0 rgba(255,255,255,.25),2px 2px 0 #000;text-shadow:1px 1px 0 #000}
#syspanel button:active{transform:translate(2px,2px)}
#syspanel button.on{background:#2bc9a6;color:#04302a;text-shadow:none}
#syspanel .sp-krow{display:grid;grid-template-columns:88px 1fr auto;gap:6px;align-items:center;padding:2px 0;border-bottom:1px dashed #1d5a60}
#syspanel .sp-kn{font-weight:900;color:#eaf0ff}
#syspanel .sp-kc i{font-style:normal;display:inline-block;min-width:22px;text-align:center;padding:1px 5px;margin:0 4px 2px 0;background:#252b52;border:2px solid #0b0b10;color:#ffd24a;box-shadow:inset -2px -2px 0 rgba(0,0,0,.35)}
#syspanel .sp-krow.wait .sp-kc{color:#ffd24a;font-weight:900;animation:dlgblink .6s steps(2) infinite}
#syspanel .sp-krow button{padding:2px 8px;font-size:11px}
#syspanel .sp-foot{display:flex;flex-direction:column;gap:4px;align-items:flex-start}
#syspanel .sp-foot small{font-size:10px;color:#aab3e0;line-height:1.4}
#syspanel .sp-tg{display:grid;grid-template-columns:1fr 1fr;gap:6px}
#syspanel #sp-info b{display:inline-block;min-width:64px;color:#aab3e0}
#syspanel #sp-info em{font-style:normal;color:#4cc35a;font-weight:900}
#syspanel .sp-help{color:#cfd6ff;font-size:10.5px}
#syspanel.boot .mon{animation:crton .55s steps(9) both;animation-delay:calc(var(--i)*.16s)}
@keyframes crton{0%{opacity:0;transform:scale(0,.02);filter:brightness(5)}30%{opacity:1;transform:scale(1,.02);filter:brightness(4)}65%{transform:scale(1,1.08);filter:brightness(2)}100%{transform:none;filter:none}}
@media (max-width:560px){#syspanel .sp-grid{grid-template-columns:1fr}#syspanel .m-keys{grid-row:auto}}

#pz{position:absolute;top:calc(8px + env(safe-area-inset-top,0px));right:calc(162px + env(safe-area-inset-right,0px));width:46px;height:40px;border:4px solid #0b0b10;background:var(--btn);color:#fff;font:900 13px ui-monospace,Menlo,Consolas,monospace;box-shadow:3px 3px 0 #000;opacity:.85;padding:0;letter-spacing:-1px}
#pz.on{background:#ffd24a;color:#3a2a00}
