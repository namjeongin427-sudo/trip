function segWall(ox,oy,tx,ty){ // 두 점 사이에 닫힌 벽이 있으면 true
 const dx=tx-ox,dy=ty-oy,dist=Math.hypot(dx,dy);if(dist<1e-6)return false;
 for(const w of SOLIDS){if(w.open||w.broken)continue;const t=rayRect(ox,oy,dx/dist,dy/dist,w.x,w.base,w.x+w.w,w.base+w.h);if(t!==null&&t<dist)return true;}
 return false;
}
function wallBlocked(tx,ty){return segWall(x,h+20,tx,ty);} // 플레이어 가슴 높이 ~ 대상 사이
function wallPush(m,x0,y0,y1){ // 몬스터가 닫힌 벽을 뚫지 못하게 밀어냄 (x0: 이동 전 x)
 const hw=m.w/2;
 for(const w of SOLIDS){if(w.open||w.broken)continue;if(y0>=w.base+w.h||y1<=w.base)continue;
  const L=w.x-hw,Rr=w.x+w.w+hw;if(m.x>L&&m.x<Rr){m.x=(x0<=w.x+w.w/2)?L:Rr;if(m.kv)m.kv=0;}}
}
function inRange(d){return Math.abs(d.x-x)<=ATK_RANGE+d.w/2&&Math.abs(h-d.base)<=(air?AIR_V_TOL:30)&&!wallBlocked(d.x,targetCenter(d).y);}
function startAttack(){
 attacking=true;atkT=0;hitDone=false;swingDone=false;
 let best=null,bd=1e9;targets.forEach(d=>{if(d.dead<=0&&inRange(d)){const dd=Math.abs(d.x-x);if(dd<bd){bd=dd;best=d;}}});
 if(best)facing=best.x>=x?1:-1;
}
function tryAttack(){
 if(pull&&ready&&!playerDead&&!trans){if(pull.win)pullStrike();else pull.buf=0.5;return;} // 접근 중 미리 눌러도 타격 구간에 들어가면 바로 타격(입력 버퍼)
 if(reeling&&reel){if(reel.tm&&!reel.arrived){reelStrike(true);return;}if(!reel.arrived)return;reelCancel();}
 if(!ready||trans||playerDead||spawning||casting||dashing||attacking||cd>0)return;
 if(sw)webRelease(false);
