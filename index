const joyEl=document.getElementById('joy'),knob=document.getElementById('knob'),jz=document.getElementById('joyzone');
let joyId=null,bx=0,by=0;
function resetJoy(){joyId=null;joy.dir=0;joy.run=false;joy.vy=0;joyEl.classList.remove('on','run');joyPlace();knob.style.transform='';}
function joyUpdate(e){
 const JR=JOY_R*UI.scale;let dx=e.clientX-bx,dy=e.clientY-by;const d=Math.hypot(dx,dy);
 if(d>JR){dx*=JR/d;dy*=JR/d;}
 knob.style.transform='translate('+dx+'px,'+dy+'px)';
 const r=Math.abs(dx)/JR;
 joy.dir=r>=JOY_DEAD?Math.sign(dx):0;
 joy.run=joy.dir!==0&&r>=JOY_RUN;
 joy.vy=(Math.abs(dy)/JR>0.5)?Math.sign(dy):0;
 joyEl.classList.toggle('run',joy.run);
}
const rz=document.getElementById('rightzone');
function clampN(v,a,b){return Math.max(a,Math.min(b,v));}
function joyCenter(){const r=joyEl.getBoundingClientRect();return [r.left+r.width/2,r.top+r.height/2];}
function joyPlace(){ // 사용자 지정 위치가 있으면 그 자리에, 없으면 기본 위치(CSS)
 const u=UI.pos&&UI.pos.joy;
 if(!u){joyEl.style.left=joyEl.style.top=joyEl.style.bottom=joyEl.style.right='';return;}
 const JR=JOY_R*UI.scale,cx=clampN(u.fx*innerWidth,JR,innerWidth-JR),cy=clampN(u.fy*innerHeight,JR,innerHeight-JR);
 joyEl.style.right='auto';joyEl.style.bottom='auto';joyEl.style.left=(cx-JR)+'px';joyEl.style.top=(cy-JR)+'px';
}
function joyStart(e,z){
 if(joyId!==null||layEdit||UI.pc)return;
 const JR=JOY_R*UI.scale;
 if(UI.joyFix){const c=joyCenter();if(Math.hypot(e.clientX-c[0],e.clientY-c[1])>Math.max(JR*2.6,44))return;bx=c[0];by=c[1];} // 고정형: 조이스틱 근처를 눌러야 동작
 else{if(z!==jz)return;const m=JR+12,lo=UI.lefty?innerWidth*0.5+m:m,hi=UI.lefty?innerWidth-m:innerWidth*0.5-m;bx=Math.max(lo,Math.min(hi,e.clientX));by=Math.max(m+40,Math.min(innerHeight-m,e.clientY));
  joyEl.style.bottom='auto';joyEl.style.right='auto';joyEl.style.left=(bx-JR)+'px';joyEl.style.top=(by-JR)+'px';} // 유동형: 누른 자리에 생김
 e.preventDefault();joyId=e.pointerId;try{z.setPointerCapture(e.pointerId);}catch(_){}joyEl.classList.add('on');joyUpdate(e);
}
jz.addEventListener('pointerdown',e=>joyStart(e,jz));
rz.addEventListener('pointermove',e=>{if(e.pointerId===joyId)joyUpdate(e);});
['pointerup','pointercancel'].forEach(n=>rz.addEventListener(n,e=>{if(e.pointerId===joyId)resetJoy();}));
