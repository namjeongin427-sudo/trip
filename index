let layEdit=false;
const UI={vib:true,wake:true,scale:1,op:1,lefty:false,fps30:false,pc:false,pos:{},joyFix:false}; // pos: 버튼별 사용자 지정 위치(화면 비율), joyFix: 조이스틱 고정형 // 모바일 설정
function resetBind(){for(const a in DEFBIND)BIND[a]=DEFBIND[a].slice();}
function rebuildMap(){for(const k in map)delete map[k];for(const a in BIND)BIND[a].forEach(k=>{map[k]=a;if(k.length===1)map[k.toUpperCase()]=a;});}
function saveSettings(){try{localStorage.setItem(SETKEY,JSON.stringify({bind:BIND,showSt:showSt,ui:UI}));}catch(_){}}
function loadSettings(){resetBind();try{const o=JSON.parse(localStorage.getItem(SETKEY)||'null');if(o){if(o.bind)for(const a in DEFBIND)if(Array.isArray(o.bind[a])&&o.bind[a].length&&o.bind[a].every(k=>typeof k==='string'))BIND[a]=o.bind[a];if(typeof o.showSt==='boolean')showSt=o.showSt;if(o.ui){for(const k of ['vib','wake','lefty','fps30','pc'])if(typeof o.ui[k]==='boolean')UI[k]=o.ui[k];if([0.6,0.85,1,1.2,1.4].includes(o.ui.scale))UI.scale=o.ui.scale;if([1,0.75,0.5,0.3].includes(o.ui.op))UI.op=o.ui.op;if(o.ui.pos&&typeof o.ui.pos==='object')for(const id of ['jmp','atk','skl','dsh','web','joy']){const u=o.ui.pos[id];if(u&&isFinite(u.fx)&&isFinite(u.fy))UI.pos[id]={fx:Math.min(1,Math.max(0,+u.fx)),fy:Math.min(1,Math.max(0,+u.fy))};}if(typeof o.ui.joyFix==='boolean')UI.joyFix=o.ui.joyFix;}}}catch(_){}rebuildMap();}
function setBind(act,key){
 const old=BIND[act].slice();
 for(const a in BIND){if(a===act)continue;const i=BIND[a].indexOf(key);if(i>=0){BIND[a].splice(i,1);if(!BIND[a].length)BIND[a]=old.slice(0,1);}} // 겹치면 서로 교환
 BIND[act]=[key];rebuildMap();saveSettings();
}
