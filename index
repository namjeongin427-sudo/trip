<!DOCTYPE html>
<html lang="ko"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><meta name="theme-color" content="#0e1020">
<title>뮤트 베타</title>
<style>
:root{--bg:#0e1020;--fg:#eaf0ff;--btn:#5a4a9a;--btnfg:#fff;--accent:#ff9f43;--skill:#2ee66b}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;overflow:hidden;overscroll-behavior:none;touch-action:none;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;background:var(--bg);color:var(--fg);font-family:ui-monospace,"SF Mono",Menlo,Consolas,"Apple SD Gothic Neo","Noto Sans KR",monospace}
#stage{position:fixed;inset:0;display:flex;align-items:center;justify-content:center}
canvas{width:min(100vw,calc(100dvh * 2));aspect-ratio:2/1;display:block;image-rendering:pixelated;image-rendering:crisp-edges;background:#161a33}
#ui{position:fixed;inset:0;pointer-events:none}
#ui>*{pointer-events:auto}
#joyzone,#rightzone{position:absolute;top:0;bottom:0;width:50%}
#joyzone{left:0}#rightzone{right:0}
#joy{position:absolute;left:calc(36px + env(safe-area-inset-left,0px));bottom:calc(36px + env(safe-area-inset-bottom,0px));width:calc(128px*var(--bs,1));height:calc(128px*var(--bs,1));border:4px solid #fff;background:rgba(20,20,40,.35);opacity:calc(.45*var(--uiop,1));pointer-events:none;box-shadow:4px 4px 0 #000;transition:opacity .12s}
#joy.on{opacity:calc(.9*var(--uiop,1))}body.lefty #joy{left:auto;right:calc(36px + env(safe-area-inset-right,0px))}body.lefty #joyzone{left:auto;right:0}body.lefty #rightzone{right:auto;left:0}
#joy .ring{position:absolute;left:50%;top:50%;width:calc(92px*var(--bs,1));height:calc(92px*var(--bs,1));margin:calc(-46px*var(--bs,1)) 0 0 calc(-46px*var(--bs,1));border:4px dotted #fff;opacity:.5}
#joy .knob{position:absolute;left:50%;top:50%;width:calc(48px*var(--bs,1));height:calc(48px*var(--bs,1));margin:calc(-24px*var(--bs,1)) 0 0 calc(-24px*var(--bs,1));background:var(--btn);border:4px solid #fff;box-shadow:inset -4px -4px 0 rgba(0,0,0,.35),inset 4px 4px 0 rgba(255,255,255,.3);will-change:transform}
#joy.run{border-color:var(--accent)}
#joy.run .knob{background:var(--accent)}
.btn{position:absolute;border:4px solid #0b0b10;background:var(--btn);color:var(--btnfg);font-weight:900;display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:inset -5px -5px 0 rgba(0,0,0,.35),inset 5px 5px 0 rgba(255,255,255,.28),5px 5px 0 #000;letter-spacing:-1px}
.btn.p{transform:translate(3px,3px);box-shadow:inset -5px -5px 0 rgba(0,0,0,.35),inset 5px 5px 0 rgba(255,255,255,.28),2px 2px 0 #000}
.btn::after{content:"";position:absolute;inset:0;background:conic-gradient(rgba(0,0,0,.62) var(--cd,0deg),transparent 0)}
.btn{opacity:calc(var(--uiop,1)*var(--st,1))}
body.pcmode .btn,body.pcmode #joy{visibility:hidden!important;pointer-events:none!important}body.pcmode #joyzone{pointer-events:none}.btn span{position:relative;z-index:1;font-size:calc(18px*var(--bs,1));text-shadow:2px 2px 0 #000}
#atk{width:96px;height:96px;right:calc(28px + env(safe-area-inset-right,0px));bottom:calc(30px + env(safe-area-inset-bottom,0px));background:#c0392b}
#skl{width:76px;height:76px;right:calc(46px + env(safe-area-inset-right,0px));bottom:calc(140px + env(safe-area-inset-bottom,0px));background:var(--skill);color:#04210f}
#skl span{text-shadow:2px 2px 0 rgba(255,255,255,.35)}
#dsh{width:70px;height:70px;right:calc(134px + env(safe-area-inset-right,0px));bottom:calc(150px + env(safe-area-inset-bottom,0px));background:#2bd9e8;color:#032a2e}
#dsh span{text-shadow:2px 2px 0 rgba(255,255,255,.35)}
#web{width:70px;height:70px;right:calc(224px + env(safe-area-inset-right,0px));bottom:calc(72px + env(safe-area-inset-bottom,0px));background:#2bc9a6;color:#05302a}
#web span{text-shadow:2px 2px 0 rgba(255,255,255,.4)}
#jmp{width:76px;height:76px;right:calc(138px + env(safe-area-inset-right,0px));bottom:calc(58px + env(safe-area-inset-bottom,0px));background:#2f6fd0}
#fs{position:absolute;top:calc(8px + env(safe-area-inset-top,0px));right:calc(8px + env(safe-area-inset-right,0px));width:40px;height:40px;border:4px solid #0b0b10;background:var(--btn);color:#fff;font-size:18px;box-shadow:3px 3px 0 #000;opacity:.8}
#bgmb,#sfxb{position:absolute;top:calc(8px + env(safe-area-inset-top,0px));width:46px;height:40px;border:4px solid #0b0b10;background:var(--btn);color:#fff;font:900 11px ui-monospace,Menlo,Consolas,monospace;box-shadow:3px 3px 0 #000;opacity:.85;text-shadow:1px 1px 0 #000;padding:0}
#sfxb{right:calc(58px + env(safe-area-inset-right,0px))}#bgmb{right:calc(110px + env(safe-area-inset-right,0px))}
.snd-off{opacity:.35!important;text-decoration:line-through}
#spawnui{position:absolute;left:calc(10px + env(safe-area-inset-left,0px));top:calc(56px + env(safe-area-inset-top,0px));display:none;gap:6px}
#spawnui button{height:36px;padding:0 10px;border:4px solid #0b0b10;background:var(--btn);color:#fff;font:900 12px ui-monospace,Menlo,Consolas,'Apple SD Gothic Neo','Noto Sans KR',monospace;box-shadow:3px 3px 0 #000;text-shadow:1px 1px 0 #000}
#spawnui button:active{transform:translate(2px,2px);box-shadow:1px 1px 0 #000}
#dsh.near{background:#ffd24a;color:#3a2a00;animation:nearpulse .5s steps(2) infinite}
@keyframes nearpulse{50%{filter:brightness(1.25)}}
#cpanel{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:rgba(5,6,16,.66);z-index:30}
#cpanel .cp-box{width:min(94vw,600px);max-height:96vh;overflow:auto;background:#161a33;border:4px solid #0b0b10;box-shadow:6px 6px 0 #000,inset 0 0 0 3px #2b3366;padding:12px 14px;display:flex;flex-direction:column;gap:10px;font-family:ui-monospace,Menlo,Consolas,'Apple SD Gothic Neo','Noto Sans KR',monospace;color:#eaf0ff}
#cpanel .cp-title{font-weight:900;font-size:15px;color:#46f0c8;text-shadow:2px 2px 0 #000;letter-spacing:1px}
#cpanel .cp-list{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
#cpanel .cp-card{display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 4px;background:#252b52;border:4px solid #0b0b10;color:#fff;font:inherit;box-shadow:inset -3px -3px 0 rgba(0,0,0,.35),inset 3px 3px 0 rgba(255,255,255,.12)}
#cpanel .cp-card canvas{height:54px;width:auto;max-width:100%;image-rendering:pixelated}
#cpanel .cp-card b{font-size:13px;text-shadow:1px 1px 0 #000}
#cpanel .cp-card i{font-style:normal;font-size:10px;color:#aab3e0}
#cpanel .cp-card.sel{border-color:#46f0c8;background:#1f4a52;box-shadow:inset -3px -3px 0 rgba(0,0,0,.35),inset 3px 3px 0 rgba(255,255,255,.2),0 0 0 3px #ffd24a}
#cpanel .cp-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
#cpanel .cp-row>span{font-weight:900;font-size:13px}
#cpanel #cp-n{min-width:26px;text-align:center;font-size:16px;color:#ffd24a;text-shadow:2px 2px 0 #000}
#cpanel button{font:inherit;font-weight:900;font-size:13px;color:#fff;background:var(--btn);border:4px solid #0b0b10;padding:8px 12px;box-shadow:inset -3px -3px 0 rgba(0,0,0,.35),inset 3px 3px 0 rgba(255,255,255,.25),3px 3px 0 #000;text-shadow:1px 1px 0 #000}
#cpanel button:active{transform:translate(2px,2px)}
#cpanel #cp-spawn{background:#2bc9a6;color:#04302a;text-shadow:1px 1px 0 rgba(255,255,255,.4)}
#cpanel #cp-clear{background:#c0392b}
#cpanel .cp-info{font-size:11px;color:#aab3e0}
#dlg{position:absolute;inset:0;display:none;align-items:flex-end;justify-content:center;background:rgba(5,6,16,.28);z-index:40;padding:0 8px calc(12px + env(safe-area-inset-bottom,0px))}
#dlg .dlg-box{position:relative;display:flex;gap:10px;width:min(96vw,780px);background:#161a33;border:4px solid #0b0b10;box-shadow:6px 6px 0 #000,inset 0 0 0 3px #2b3366;padding:10px;font-family:ui-monospace,Menlo,Consolas,'Apple SD Gothic Neo','Noto Sans KR',monospace;color:#eaf0ff}
#dlg .dlg-portrait{flex:none;width:min(27vh,150px);aspect-ratio:1;border:4px solid #0b0b10;background:#6f86c0;box-shadow:inset 0 0 0 3px #8fa4d8,3px 3px 0 #000;overflow:hidden}
#dlg canvas{display:block;width:100%;height:100%;image-rendering:pixelated}
#dlg .dlg-main{flex:1;display:flex;flex-direction:column;gap:6px;min-width:0}
#dlg .dlg-name{align-self:flex-start;background:#46f0c8;color:#04302a;font-weight:900;font-size:clamp(11px,2.6vh,14px);padding:2px 10px;border:3px solid #0b0b10;box-shadow:2px 2px 0 #000}
#dlg .dlg-text{flex:1;font-size:clamp(12px,3vh,17px);line-height:1.55;min-height:3.1em;word-break:keep-all;text-shadow:1px 1px 0 #000}
#dlg .dlg-next{position:absolute;right:14px;bottom:8px;color:#ffd24a;font-size:16px;visibility:hidden;animation:dlgblink .6s steps(2) infinite}
@keyframes dlgblink{50%{opacity:0}}
#dlg .dlg-hint{position:absolute;right:10px;top:-22px;font-size:11px;font-weight:900;color:#fff;text-shadow:2px 2px 0 #000;opacity:.85}
#dimpanel{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:rgba(5,6,16,.7);z-index:30}
#dimpanel .dm-box{width:min(94vw,520px);background:#161a33;border:4px solid #0b0b10;box-shadow:6px 6px 0 #000,inset 0 0 0 3px #2b3366;padding:12px 14px;display:flex;flex-direction:column;gap:10px;font-family:ui-monospace,Menlo,Consolas,'Apple SD Gothic Neo','Noto Sans KR',monospace;color:#eaf0ff}
#dimpanel .dm-title{font-weight:900;font-size:15px;color:#46f0c8;text-shadow:2px 2px 0 #000;letter-spacing:1px}
