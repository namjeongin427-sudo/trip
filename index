#pausepanel .pz-box{width:min(94vw,520px);max-height:96vh;overflow:auto;background:#161a33;border:4px solid #0b0b10;box-shadow:6px 6px 0 #000,inset 0 0 0 3px #2b3366;padding:12px 14px;display:flex;flex-direction:column;gap:10px;font-family:ui-monospace,Menlo,Consolas,'Apple SD Gothic Neo','Noto Sans KR',monospace}
