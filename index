}
function tryDash(){
 if(nearPanel&&!panelOpen){openPanel();return;} // 제어패널 근처에서는 대쉬키 = 접근(열기) 키
 if(reeling&&reel){if(!reel.arrived)return;reelCancel();}
 if(!ready||trans||playerDead||spawning||casting||attacking||dashing||dashCd>0)return;
 if(sw)webRelease(false);if(pull)releasePull();wvx=0;
 const kd=(keys.right?1:0)-(keys.left?1:0),d0=kd!==0?kd:joy.dir;if(d0!==0)facing=d0;
 dashing=true;dashPhase='out';dashT=0;dashHit=false;dashSkill=buffT>0; // 스킬 버프 중이면 스킬 대쉬
 const dist=DASH_DIST*(dashSkill?2:1);
 dashX0=x;dashX1=Math.max(CHAR_HALF,Math.min(WORLD_W-CHAR_HALF,x+facing*dist));
 const sc=scanDash(dashX0,dashX1);dashX1=sc.end;dashBreak=sc.breaks;
 sfx('dashOut');
}
function dashAoE(){
 const rng=ATK_RANGE*1.2;
 rings.push({x:x,y:GROUND-supportH(x,h),t:0,r:rng,skill:dashSkill});
 targets.forEach(d=>{if(d.dead<=0&&Math.abs(d.x-x)<=rng+d.w/2&&Math.abs(h-d.base)<=(air?AIR_V_TOL:35)&&!wallBlocked(d.x,targetCenter(d).y)){
  damageDummy(d,DASH_DMG_MULT);d.kv=(d.x>=x?1:-1)*(dashSkill?DASH_KB_SKILL:DASH_KB);dashHitAny=true;hitFx.push({x:d.x,y:GROUND-d.base-d.h/2,w:d.w,h:d.h,t:0});
  if(dashSkill)d.zap=0.8; // 스킬 대쉬: 지직거리는 글리치 추가
 }});
 if(dashHitAny){sfx('hit',{p:0.8});if(dashSkill)sfx('zap');dashHitAny=false;}
}
function tryCast(){
