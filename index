#pausepanel button:active{transform:translate(2px,2px)}
#pausepanel button.on{background:#2bc9a6;color:#04302a;text-shadow:none}
#pausepanel .pz-row{display:flex;gap:8px}
#pausepanel #pz-resume{flex:2;font-size:15px;background:#c0392b;padding:12px}
#pausepanel #pz-fs{flex:1}
#fstoast{position:absolute;left:50%;bottom:calc(14px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);display:none;gap:6px;z-index:20}
#fstoast button{font:900 12px ui-monospace,Menlo,Consolas,'Apple SD Gothic Neo','Noto Sans KR',monospace;color:#fff;background:#2f6fd0;border:4px solid #0b0b10;padding:8px 12px;box-shadow:3px 3px 0 #000;text-shadow:1px 1px 0 #000}
#fstoast button:last-child{background:var(--btn);padding:8px 10px}
